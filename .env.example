# Oracle Fusion Cloud connection settings
# Copy this file to .env and fill in your values.
# The .env file is gitignored and never committed.

# Your Fusion pod URL (from OCI Console > Fusion Applications > Environments)
# Example: https://abcd-dev1.fa.us2.oraclecloud.com
FUSION_POD_URL=https://your-pod.fa.ocs.oraclecloud.com

# Fusion user name (an integration user is recommended for production)
FUSION_USER=your.user@example.com

# Password handling:
# The setup script stores the password in your OS credential manager (not in this file).
# On Windows: Windows Credential Manager
# On macOS:   macOS Keychain
# On Linux:   Secret Service (GNOME Keyring / KWallet)
#
# If you prefer environment variables instead, uncomment the line below.
# WARNING: This is less secure — the password will be visible in process listings.
# FUSION_PASSWORD=your_password_here

# ---------------------------------------------------------------------------
# OPTIONAL: Oracle AI Agent Studio (only needed to invoke published AI agents)
# ---------------------------------------------------------------------------
# These endpoints use an OAuth2 bearer token from OCI IAM (not the password above).
# Normally you configure them with:  fusion_setup_helper.py agent-config / agent-store
# (secret stored in the OS credential manager). The env vars below are an override.
#
# FUSION_IDCS_URL=https://idcs-xxxx.identity.oraclecloud.com
# FUSION_AGENT_CLIENT_ID=your_oauth_confidential_app_client_id
# FUSION_AGENT_SCOPE=your_ai_agent_studio_scope
# FUSION_AGENT_BASE=https://your-pod.fa.ocs.oraclecloud.com/api/fusion-ai/orchestrator
# FUSION_AGENT_CLIENT_SECRET=your_oauth_client_secret   # less secure; prefer the credential store
