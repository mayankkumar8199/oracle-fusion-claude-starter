# Auto detect text files and normalize line endings
* text=auto

# Windows batch files must keep CRLF
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must keep LF
*.sh text eol=lf

# Large data catalogs — treat as binary to skip diffing
fusion-kit/tables.jsonl binary
fusion-kit/rest_catalog.json binary
fusion-kit/catalog.json binary
fusion-kit/guides_toc.json binary
